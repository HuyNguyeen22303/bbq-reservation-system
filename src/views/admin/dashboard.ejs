<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="row">
    <!-- Thẻ Tổng số bàn -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2" style="border-left: 4px solid #0d6efd;">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Tổng số bàn</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= totalTables %></div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-chair fa-2x text-gray-300" style="color: #dddfeb;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thẻ Đặt bàn chờ duyệt -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2" style="border-left: 4px solid #ffc107;">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Yêu cầu chờ duyệt</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= pendingReservations %></div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-clock fa-2x text-gray-300" style="color: #dddfeb;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Hoạt động gần đây</h6>
                <a href="/admin/reservations" class="btn btn-sm btn-primary">Xem tất cả</a>
            </div>
            <div class="card-body">
                <p>Nội dung danh sách đặt bàn gần đây sẽ hiển thị ở đây.</p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
