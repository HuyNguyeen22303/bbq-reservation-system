<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SeoulFire | Premium Korean BBQ Buffet</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- External CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Header -->

    <%- include('../partials/header') %>

        <!-- End Header --> <!-- Menu Header -->
        <div class="menu-page-header">
            <h1>Our Menu</h1>
            <p>Discover the authentic taste of Korean BBQ</p>
        </div>

        <!-- Menu Container -->
        <div class="menu-container">
            <!-- Food Menu -->
            <div class="menu-category">
                <h2 class="category-title">Food Menu</h2>
                <div class="menu-image-wrapper">
                    <img src="images/menu-food.png" alt="menu-food">
                </div>
            </div>

            <!-- Drinks Menu -->
            <div class="menu-category">
                <h2 class="category-title">Drinks Menu</h2>
                <div class="menu-image-wrapper">
                    <img src="images/bevarage-menu.jpg" alt="menu-beverage">
                </div>
            </div>
        </div> <!-- Footer -->
        <%- include('../partials/footer') %>
            <!-- END Footer -->



            <!-- External JS -->
            <script src="/js/main.js"></script>
</body>

</html>